# TODO: nvc 1.21.0 (pinned to rules_cc_autoconf 0.12.1) adds a raw
# `AC_SUBST("PACKAGE_VERSION")` next to a `package_info` target that now
# also publishes that subst, which HEAD rejects as a duplicate symbol.
# Re-enable once nvc drops the workaround or the conflict check tolerates it.
alias(
    name = "nvc",
    actual = "@nvc",
    tags = ["manual"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
