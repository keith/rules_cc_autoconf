"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/isspace_l.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_FUNC_ISSPACE_L",
    checks = [
        # AC_CHECK_FUNCS_ONCE([isspace_l])
        checks.AC_TRY_LINK(
            name = "_gl_cv_func_isspace_l",
            code = """\
#define _GNU_SOURCE 1
#include <ctype.h>
#include <locale.h>
int main(void) {
isspace_l(' ', (locale_t)0);
return 0;
}
""",
        ),
        checks.AC_DEFINE(
            "HAVE_ISSPACE_L",
            "1",
            requires = ["_gl_cv_func_isspace_l==1"],
        ),
        # if test $ac_cv_func_isspace_l = no; then HAVE_ISSPACE_L=0; fi
        # Overrides the gl_CTYPE_H_DEFAULTS value of 1 (e.g. MSVC has no isspace_l).
        checks.AC_SUBST(
            "HAVE_ISSPACE_L",
            condition = "_gl_cv_func_isspace_l",
            if_false = "0",
            if_true = "1",
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//gnulib/m4/ctype_h",  # AC_REQUIRE([gl_CTYPE_H_DEFAULTS])
        "//gnulib/m4/extensions",  # AC_REQUIRE([AC_USE_SYSTEM_EXTENSIONS]) - needed for isspace_l to be declared
        "//gnulib/m4/intl-thread-locale:gt_FUNC_USELOCALE",  # AC_REQUIRE([gt_FUNC_USELOCALE])
    ],
)

# Umbrella target kept for existing dependants.
autoconf(
    name = "isspace_l",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_ISSPACE_L",
        "//gnulib/m4/c-strtod",  # kept from the previous shape for existing dependants
    ],
)
