"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/isalpha_l.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_FUNC_ISALPHA_L",
    checks = [
        # AC_CHECK_FUNCS_ONCE([isalpha_l])
        checks.AC_TRY_LINK(
            name = "_gl_cv_func_isalpha_l",
            code = """\
#define _GNU_SOURCE 1
#include <ctype.h>
#include <locale.h>
int main(void) {
isalpha_l('a', (locale_t)0);
return 0;
}
""",
        ),
        checks.AC_DEFINE(
            "HAVE_ISALPHA_L",
            "1",
            requires = ["_gl_cv_func_isalpha_l==1"],
        ),
        # if test $ac_cv_func_isalpha_l = no; then HAVE_ISALPHA_L=0; fi
        # Overrides the gl_CTYPE_H_DEFAULTS value of 1 (e.g. MSVC has no isalpha_l).
        checks.AC_SUBST(
            "HAVE_ISALPHA_L",
            condition = "_gl_cv_func_isalpha_l",
            if_false = "0",
            if_true = "1",
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//gnulib/m4/ctype_h",  # AC_REQUIRE([gl_CTYPE_H_DEFAULTS])
        "//gnulib/m4/c-strtod",
        "//gnulib/m4/extensions",  # AC_REQUIRE([AC_USE_SYSTEM_EXTENSIONS]) - needed for isalpha_l to be declared
        # For test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf(
    name = "isalpha_l",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_ISALPHA_L",
    ],
)
